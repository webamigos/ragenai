# =============================================================================
# Core
# =============================================================================

# Possible values: local | staging | production
# Avoids overloading NODE_ENV which should only be "production" or "development"
TARGET_ENV=local

DATABASE_URL="postgresql://postgres:pass123@localhost:5432/ragen"

# Used for hashing values in Redis
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# =============================================================================
# Temporal (async document processing workflows)
# =============================================================================

TEMPORAL_SERVER_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="local"
# For Temporal Cloud only:
# TEMPORAL_CERT="" # certificate in base64
# TEMPORAL_KEY=""  # key in base64

# =============================================================================
# Redis (caching, job deduplication)
# =============================================================================

REDIS_URL="redis://localhost:6379"

# =============================================================================
# Vector Store (Qdrant — default)
# =============================================================================

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# =============================================================================
# Vector Store (Meilisearch — legacy, kept for backwards compatibility)
# =============================================================================

MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=

# =============================================================================
# File Storage
# =============================================================================

# Storage backend: "local" (default, filesystem) or "s3".
#
# ADR-27 made "local" the default so a fresh install runs with no cloud account.
# Files go to STORAGE_LOCAL_PATH, which itself defaults to ./data/storage.
#
# "local" requires every process that touches files to share ONE persistent
# filesystem. The app and the worker run as separate containers even at one
# replica each, so this means a shared, mounted volume — otherwise the worker
# writes documents the app cannot read, and a restart loses anything not on that
# volume. Use STORAGE_PROVIDER=s3 for any deployment without such a volume. The
# app logs a warning at startup when "local" is used with TARGET_ENV=production
# or staging.
#
# "s3" means any S3-compatible object store, not just AWS — see the section below.
# STORAGE_PROVIDER=local

# --- Local filesystem storage (the default) ---
# Where files are stored. Mount a Docker volume here for persistence.
# Defaults to ./data/storage when unset.
# Relative paths are resolved against the monorepo root (npm sets
# npm_config_local_prefix for any workspace script), so the app and the worker
# agree even though they run from different directories. A bare
# `node dist/worker.js` outside npm has no such anchor — set an absolute path
# there, or use s3.
# STORAGE_LOCAL_PATH=/data/storage

# --- S3 storage (only when STORAGE_PROVIDER=s3) ---
# Works with any S3-compatible API: AWS S3, Cloudflare R2, Scaleway Object
# Storage, MinIO, Ceph, LocalStack. Point S3_ENDPOINT_URL at the provider and
# set S3_FORCE_PATH_STYLE=1 if it needs path-style addressing.
#
#   AWS S3          leave S3_ENDPOINT_URL unset
#   Cloudflare R2   https://<account-id>.r2.cloudflarestorage.com
#                   S3_REGION=auto
#   MinIO / Ceph    your own endpoint, S3_FORCE_PATH_STYLE=1
#   Scaleway        see below
#
# Every var here uses an S3_ prefix, not AWS_ — deliberately, not "despite"
# it. AWS Bedrock and the AWS KMS encryption provider both read
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_ENDPOINT_URL /
# AWS_DEFAULT_REGION for real AWS config; reusing those names here for a
# non-AWS provider (Scaleway, for every deployment today) meant this worker
# could never use real AWS Bedrock/KMS and S3 storage at the same time.
# Generate these in Scaleway Console → IAM → API Keys (Access Key ID format
# "SCW...", Secret Access Key is the IAM secret UUID — same value as
# SCW_API_KEY).
#
# Scaleway Object Storage endpoint format: https://s3.<region>.scw.cloud
#   - pl-waw   (Warsaw)
#   - fr-par   (Paris)
#   - nl-ams   (Amsterdam)
# Set S3_FORCE_PATH_STYLE=1 — Scaleway's wildcard TLS cert
# (*.s3.<region>.scw.cloud) does not cover bucket names that contain dots.
#
# Leave S3_ENDPOINT_URL unset for real AWS S3.
S3_REGION=pl-waw
S3_ENDPOINT_URL=https://s3.pl-waw.scw.cloud
S3_BUCKET_NAME=
S3_FORCE_PATH_STYLE=1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# =============================================================================
# LiteLLM Proxy (unified LLM gateway — shared with apps/web)
# =============================================================================

# All chat completions and embeddings are routed through LiteLLM proxy
LITELLM_PROXY_URL=http://localhost:4000
# Use sk-litellm-dev-key for local only — MUST be changed for staging/production
LITELLM_MASTER_KEY=

# Scaleway Generative APIs (used by LiteLLM for Mistral / BGE embeddings)
# Create an IAM key with GenerativeApisFullAccess scope in Scaleway Console.
SCW_API_BASE=https://api.scaleway.ai/<SCW_PROJECT_ID>/v1
SCW_API_KEY=

# Embedding model name (must match model_name in litellm/config.yaml).
# Must be the SAME value as apps/web's EMBEDDINGS_MODEL — the worker writes the
# vectors the app queries — and its dimensionality must match VECTOR_SIZE
# (bge-multilingual-gemma2 = 3584, cohere-embed-multilingual-v3 = 1024).
EMBEDDINGS_MODEL=bge-multilingual-gemma2

# =============================================================================
# Document Parsing Engine
# =============================================================================

# Which parser to use for document ingestion: "docling" (default) or "legacy"
# - "docling": IBM Docling via REST API — unified parser producing high-quality Markdown
#   for all supported formats (PDF, DOCX, PPTX, XLSX, CSV, Images). Runs on your own
#   infrastructure (the `docling` service in docker-compose). PPTX requires docling.
# - "legacy": per-format loaders (Claude native PDF, Mammoth DOCX, SheetJS XLSX, etc.).
#   NOTE: the legacy PDF loader sends the document to an external model as base64.
# Formats Docling does not handle (SRT, EPUB) always use their legacy loader.
DOCUMENT_PARSER=docling

# URL of the docling-serve instance (only used when DOCUMENT_PARSER=docling)
# Local: http://localhost:5001 | Railway: set to internal service URL
DOCLING_URL=http://localhost:5001

# Refuse to fall back to the legacy loaders when Docling fails.
# Default (unset) degrades to legacy parsing so an outage doesn't stop ingestion.
# Set to 1 for confidential deployments: the legacy PDF path sends the document
# to an external model, so a silent fallback would ship it off-site precisely
# when local parsing is unavailable. With this set the ingest fails instead.
# DOCLING_STRICT=1

# Tables Docling parsed become their own chunks, with the column names repeated
# at the top of each one, and leave the prose as a placeholder line.
#
# Off by default and under measurement (ADR-43). The comparison is in
# apps/web/evals/rag-benchmark/results/2026-09-12-table-chunks-comparison.md:
# +3 of 18 on a corpus of documents that are mostly wide tables, +1 of 24 on
# the general corpus, no excision refused in thirteen documents.
#
# **It changes CSV and XLSX too.** Docling parses spreadsheets, and a
# spreadsheet is entirely table — with this on, its whole content becomes table
# chunks. That restores what ADR-17 gave CSV before Docling became the default
# parser, and it is the largest behaviour change in the flag.
#
# Documents already indexed keep their old chunk shape until they are
# re-indexed (Workflow.REINDEX_DOCUMENT_VERSION), so a collection holds both
# for a while. Turning it back off leaves table chunks behind; they are
# ordinary chunks with a chunk_type nothing branches on.
# FEATURE_FLAG_TABLE_CHUNKS=1

# =============================================================================
# PDF Processing
# =============================================================================

# PDF processing strategy: "claude" (default) or "vision" (legacy page-by-page)
# "claude" sends the entire PDF to Claude via native document support — faster, cheaper, better quality
# "vision" renders each page to PNG and describes via vision LLM — fallback for non-Claude setups
PDF_PROCESSOR=claude

# Model used for Claude native PDF processing (must be a Claude model in litellm/config.yaml)
# Recommended: claude-haiku-4-5 (cheapest/fastest), claude-sonnet-4-6 (highest quality)
PDF_MODEL=claude-haiku-4-5

# DEPRECATED: These vars were replaced by LiteLLM proxy routing (see LITELLM_* above).
# OPENAI_API_KEY=           # No longer used — configure OpenAI keys in litellm/config.yaml
# ENABLE_OPENROUTER=false   # No longer used — configure OpenRouter in litellm/config.yaml

# =============================================================================
# Document Summaries at Ingest (ADR-16)
# =============================================================================

# Model used to generate a 1-2 paragraph summary of each ingested document.
# The summary is stored both as a synthetic chunk in Qdrant (chunk_type: summary)
# and on UserFile.metadata.summary. Must match a model_name in litellm/config.yaml.
# gemini-2.5-flash is the default — noticeably faster than gpt-5.4-nano for the
# short-output summary task in practice and has strong Polish support. Do NOT
# upgrade to a larger model without explicit approval; summaries run per-document
# and cost matters.
SUMMARY_MODEL=gemini-2.5-flash

# Enable/disable document summary generation at ingest time. Defaults to ON;
# set to 0 or false to skip summary generation entirely. When off, documents
# are still ingested normally — just without a summary chunk or metadata.
# FEATURE_FLAG_DOC_SUMMARIES=1

# =============================================================================
# Pusher (real-time notifications to apps/web frontend)
# =============================================================================

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=

# =============================================================================
# Ragen App (usage reporting)
# =============================================================================

# URL of the apps/web instance this worker reports to
RAGEN_APP_URL="" # e.g. https://ragen.example.com
# Shared secret for authenticating with apps/web (must match WORKER_SECRET_KEY in apps/web)
WORKER_SECRET_KEY=""

# =============================================================================
# Observability (OpenTelemetry)
# =============================================================================

# OTEL_SERVICE_NAME=ragen-worker    # defaults to "ragen-worker" if unset
# OTEL_EXPORTER_OTLP_ENDPOINT=     # e.g. https://otel-collector.example.com

# =============================================================================
# Optional integrations
# =============================================================================

# Langfuse — LLM call tracing (handled by LiteLLM proxy)
# Set these on the LiteLLM container, not the worker.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=                    # e.g. https://cloud.langfuse.com

# Firecrawl — web page scraping for URL document loader (optional)
# FIRECRAWL_API_KEY=

# Presidio — PII masking during document ingest.
#
# Off by default: masking requires two extra containers, and without this flag
# ingest simply skips it (no analyzer calls, nothing redacted in the index).
# Turn it on for deployments in regulated industries — the value must match
# apps/web's FEATURE_FLAG_PII_MASKING, otherwise chat and ingest disagree
# about whether PII is being masked.
# FEATURE_FLAG_PII_MASKING=1
#
# Defaults to Docker service names (http://presidio-analyzer:3000 etc.) which
# only resolve inside docker-compose. When running the worker locally against
# the docker-compose presidio containers, override with the host-mapped ports
# from the root docker-compose.yml (5002 / 5003).
# PRESIDIO_ANALYZER_URL=http://localhost:5002
# PRESIDIO_ANONYMIZER_URL=http://localhost:5003
# PRESIDIO_TIMEOUT_MS=15000
